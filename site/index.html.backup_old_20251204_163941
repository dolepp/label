<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TWAS Label</title>
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <style>
    :root {
      --primary: #6a11cb;
      --secondary: #2575fc;
      --dark: #1a1a2e;
      --light: #f8f9fa;
      --success: #28a745;
      --danger: #dc3545;
      --warning: #ffc107;
      --info: #17a2b8;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: var(--light);
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .logo {
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(to right, #fff, #ccc);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .auth-buttons {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .auth-buttons button {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: white;
      padding: 8px 15px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .auth-buttons button:hover {
      background: rgba(255,255,255,0.2);
    }

    .telegram-btn {
      background: #0088cc !important;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }


    .logout-btn {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: white;
      padding: 8px 15px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .logout-btn:hover {
      background: rgba(255,255,255,0.2);
    }

    .main-menu {
      display: flex;
      justify-content: center;
      margin: 30px 0;
      flex-wrap: wrap;
    }

    .menu-btn {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: white;
      padding: 15px 25px;
      margin: 0 10px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s;
      font-size: 16px;
      font-weight: 500;
      min-width: 180px;
      text-align: center;
      margin-bottom: 15px;
    }

    .menu-btn:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-3px);
    }

    .hero {
      text-align: center;
      padding: 50px 20px;
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 20px;
      background: linear-gradient(to right, #fff, #ccc);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 18px;
      max-width: 800px;
      margin: 0 auto 30px;
      line-height: 1.6;
    }

    .section {
      background: rgba(255,255,255,0.05);
      border-radius: 15px;
      padding: 30px;
      margin-bottom: 30px;
      display: none;
    }

    .section.active {
      display: block;
      animation: fadeIn 0.5s;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .section-title {
      font-size: 24px;
      margin-bottom: 20px;
      color: white;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      padding-bottom: 10px;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }

    .service-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 20px;
      transition: all 0.3s;
    }

    .service-card:hover {
      background: rgba(255,255,255,0.07);
      transform: translateY(-5px);
    }

    .service-card h3 {
      font-size: 20px;
      margin-bottom: 15px;
      color: white;
    }

    .service-card p {
      color: rgba(255,255,255,0.7);
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .service-card .price {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 15px;
      color: white;
    }

    .btn {
      display: inline-block;
      background: linear-gradient(to right, var(--primary), var(--secondary));
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      opacity: 0.9;
      transform: translateY(-2px);
    }

    .btn-outline {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.3);
    }

    .btn-outline:hover {
      background: rgba(255,255,255,0.1);
    }

    .btn-outline.active {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .profile-info {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }

    .profile-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 20px;
    }

    .profile-card h3 {
      font-size: 18px;
      margin-bottom: 15px;
      color: white;
    }

    .profile-card p {
      color: rgba(255,255,255,0.7);
      margin-bottom: 10px;
    }

    .profile-card .value {
      color: white;
      font-weight: 500;
    }

    .user-level {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      margin-right: 5px;
      margin-bottom: 5px;
    }

    .level-artist { background: #6c757d; }
    .level-admin { background: #dc3545; }
    .level-owner { background: #6a11cb; }
    .level-steezy { background: #fd7e14; }
    .level-bibi { background: #20c997; }
    .level-shvepz { background: #6610f2; }
    .level-creator { background: #17a2b8; }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: white;
    }

    .form-control {
      width: 100%;
      padding: 10px 15px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 5px;
      color: white;
      font-size: 16px;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.7);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background: #1a1a2e;
      border-radius: 10px;
      padding: 30px;
      max-width: 500px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .support-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
      margin-top: 15px;
    }

    .support-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 15px;
      cursor: pointer;
      transition: all 0.3s;
      text-align: left;
    }

    .support-card:hover,
    .support-card.active {
      border-color: var(--secondary);
      background: rgba(37,117,252,0.15);
    }

    .support-card h4 {
      margin: 0 0 8px;
      color: #fff;
      font-size: 18px;
    }

    .support-card p {
      margin: 0;
      color: rgba(255,255,255,0.65);
      font-size: 14px;
    }

    .support-note {
      margin-top: 15px;
      padding: 12px;
      border-radius: 8px;
      background: rgba(255,255,255,0.05);
      color: rgba(255,255,255,0.85);
      font-size: 14px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-prinyat { background: rgba(40,167,69,0.2); color: #8ef3b3; }
    .status-reshen { background: rgba(0,123,255,0.2); color: #9fd5ff; }
    .status-treb { background: rgba(255,193,7,0.2); color: #ffe08a; }
    .status-work { background: rgba(111,66,193,0.2); color: #d3b6ff; }

    .requests-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    .requests-table th,
    .requests-table td {
      text-align: left;
      padding: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .requests-table th {
      font-weight: 600;
      color: rgba(255,255,255,0.85);
    }

    .orders-empty {
      color: rgba(255,255,255,0.6);
      font-style: italic;
    }

    .admin-orders-list .admin-order-item {
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 15px;
      background: rgba(255,255,255,0.02);
    }

    .admin-order-item h4 {
      margin: 0 0 8px;
      color: #fff;
    }

    .admin-order-item select {
      width: 100%;
      margin-top: 10px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: #fff;
      padding: 8px;
      border-radius: 6px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-title {
      font-size: 22px;
      color: white;
    }

    .close-modal {
      background: none;
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
    }

    /* Distribution form styles */
    .distribution-step {
      margin-bottom: 20px;
    }

    .release-type-grid button {
      padding: 20px;
      text-align: center;
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: all 0.3s;
    }

    .release-type-grid button:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-2px);
    }

    .release-type-grid button.active {
      background: rgba(77, 182, 172, 0.3);
      border-color: #4db6ac;
    }

    .price-tag {
      color: #4db6ac;
      font-weight: bold;
      font-size: 14px;
    }

    .file-upload-area {
      border: 2px dashed rgba(255,255,255,0.3);
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      margin: 10px 0;
      transition: all 0.3s;
    }

    .file-upload-area:hover {
      border-color: #4db6ac;
      background: rgba(77, 182, 172, 0.1);
    }

    .upload-placeholder {
      cursor: pointer;
      color: rgba(255,255,255,0.7);
    }

    .upload-placeholder:hover {
      color: #4db6ac;
    }

    #cover-preview img {
      border-radius: 10px;
      margin-bottom: 10px;
    }

    .distribution-step h4 {
      color: #4db6ac;
      margin-bottom: 20px;
      border-bottom: 2px solid rgba(77, 182, 172, 0.3);
      padding-bottom: 10px;
    }

    .releases-list, .orders-list, .recordings-list {
      margin-top: 20px;
    }

    .release-item, .order-item, .recording-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
    }

    .release-item h4, .order-item h4, .recording-item h4 {
      margin: 0 0 10px 0;
      color: white;
    }

    .status {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      margin-right: 5px;
    }

    .status-accepted { background: #28a745; }
    .status-sent { background: #17a2b8; }
    .status-delivered { background: #6a11cb; }
    .status-released { background: #20c997; }
    .status-withdrawn { background: #dc3545; }

    .admin-panel {
      display: none;
    }

    .admin-section {
      margin-bottom: 30px;
    }

    .admin-section h3 {
      font-size: 20px;
      margin-bottom: 15px;
      color: white;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 15px;
      margin-bottom: 20px;
    }

    .stat-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 15px;
      text-align: center;
    }

    .stat-card .value {
      font-size: 24px;
      font-weight: 700;
      color: white;
      margin: 10px 0;
    }

    .stat-card .label {
      font-size: 14px;
      color: rgba(255,255,255,0.7);
    }

    .tab-buttons {
      display: flex;
      margin-bottom: 20px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .tab-btn {
      padding: 10px 20px;
      background: none;
      border: none;
      color: rgba(255,255,255,0.7);
      cursor: pointer;
      font-size: 16px;
      position: relative;
    }

    .tab-btn.active {
      color: white;
    }

    .tab-btn.active:after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--primary);
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .reviews-filter {
      margin-bottom: 20px;
    }

    .review-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
    }

    .review-item h4 {
      margin: 0 0 5px 0;
      color: white;
    }

    .review-item .service {
      display: inline-block;
      padding: 2px 8px;
      background: rgba(106, 17, 203, 0.3);
      border-radius: 20px;
      font-size: 12px;
      margin-bottom: 10px;
    }

    .review-item .text {
      color: rgba(255,255,255,0.8);
      line-height: 1.5;
    }

    .referral-section {
      text-align: center;
      padding: 30px;
      background: rgba(255,255,255,0.03);
      border-radius: 10px;
      margin-top: 30px;
    }

    .referral-link {
      background: rgba(255,255,255,0.05);
      border: 1px dashed rgba(255,255,255,0.2);
      padding: 15px;
      border-radius: 8px;
      margin: 20px 0;
      word-break: break-all;
    }

    .referral-stats {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    .referral-stat {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 15px;
      min-width: 150px;
    }

    .referral-stat .value {
      font-size: 24px;
      font-weight: 700;
      color: white;
      margin: 5px 0;
    }

    .referral-stat .label {
      font-size: 14px;
      color: rgba(255,255,255,0.7);
    }

    .admin-only {
      border: 1px solid rgba(255, 193, 7, 0.3);
      background: rgba(255, 193, 7, 0.05);
    }

    .payment-method-btn {
      flex: 1;
      min-width: 120px;
    }

    .payment-method-btn.active {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .rating-stars .star {
      cursor: pointer;
      color: rgba(255,255,255,0.3);
      transition: color 0.3s;
      margin-right: 5px;
    }

    .rating-stars .star:hover,
    .rating-stars .star.active {
      color: #ffc107;
    }

    .topup-amount-btn {
      flex: 1;
      min-width: 100px;
    }

    .payment-status {
      padding: 10px;
      border-radius: 5px;
      margin: 10px 0;
      text-align: center;
    }

    .payment-status.pending {
      background: rgba(255, 193, 7, 0.2);
      border: 1px solid rgba(255, 193, 7, 0.5);
    }

    .payment-status.success {
      background: rgba(40, 167, 69, 0.2);
      border: 1px solid rgba(40, 167, 69, 0.5);
    }

    .payment-status.failed {
      background: rgba(220, 53, 69, 0.2);
      border: 1px solid rgba(220, 53, 69, 0.5);
    }

    .contract-item, .report-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
    }

    .contract-item h4, .report-item h4 {
      margin: 0 0 10px 0;
      color: white;
    }

    .contract-status, .report-status {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      margin-right: 5px;
    }

    .status-pending { background: #ffc107; color: #000; }
    .status-processing { background: #17a2b8; }
    .status-completed { background: #28a745; }
    .status-rejected { background: #dc3545; }

    .progress-bar {
      width: 100%;
      height: 20px;
      background: rgba(255,255,255,0.1);
      border-radius: 10px;
      overflow: hidden;
      margin: 10px 0;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(to right, var(--primary), var(--secondary));
      transition: width 0.3s ease;
    }

    .file-upload-area {
      border: 2px dashed rgba(255,255,255,0.3);
      border-radius: 10px;
      padding: 30px;
      text-align: center;
      transition: all 0.3s;
      cursor: pointer;
    }

    .file-upload-area:hover {
      border-color: var(--primary);
      background: rgba(255,255,255,0.05);
    }

    .file-upload-area.drag-over {
      border-color: var(--secondary);
      background: rgba(255,255,255,0.1);
    }

    .upload-icon {
      font-size: 48px;
      color: rgba(255,255,255,0.5);
      margin-bottom: 15px;
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 36px;
      }

      .menu-btn {
        min-width: 140px;
        padding: 12px 20px;
      }

      .services-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
