  function startAuthStatusCheck(authToken) {
    let checkCount = 0;
    const maxChecks = 60; // 5 ?????????? (60 * 5 ????????????)
    
    window.authCheckInterval = setInterval(async () => {
      checkCount++;
      
      try {
        // ?????? ???????????????????????? - ???????????????????? API ????????????
        let data;
        
        // ?????????????????? ????????-?????????? ?????? ???????????????????????? ?????????????????? ????????
