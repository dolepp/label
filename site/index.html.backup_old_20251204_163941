              balance: 1500,
            }
          };
        } else {
          // ???????????????? API ????????????
          const response = await fetch(`${API_BASE_URL}/api/auth/check?token=${authToken}`, {
            credentials: 'include'
          });
          data = await response.json();
        }
        
        if (data.success && data.authenticated) {
          // ???????????????? ??????????????????????
          clearInterval(window.authCheckInterval);
          
