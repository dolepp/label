  function openSupportTemplate(templateId) {
    const template = getSupportTemplateById(templateId);
    const formCard = document.getElementById('support-form-card');
    const formFields = document.getElementById('support-form-fields');
    const description = document.getElementById('support-form-description');
    const extra = document.getElementById('support-extra-note');
    const submitBtn = document.getElementById('support-form-submit');

    if (!template || !formCard || !formFields) return;

    activeSupportTemplateId = templateId;
    formCard.style.display = 'block';
    document.querySelectorAll('.support-card').forEach(card => {
      card.classList.toggle('active', card.dataset.templateId === templateId);
    });

    document.getElementById('support-form-title').textContent = template.title;
    description.textContent = template.description;

    formFields.innerHTML = '';
    template.fields.forEach(field => {
      const wrapper = document.createElement('div');
      wrapper.className = 'form-group';
      const label = document.createElement('label');
      label.textContent = field.label + (field.required ? ' *' : '');
      wrapper.appendChild(label);

      if (field.type === 'textarea') {
        const textarea = document.createElement('textarea');
        textarea.className = 'form-control';
        textarea.name = field.id;
        textarea.placeholder = field.placeholder || '';
        if (field.required) textarea.required = true;
        wrapper.appendChild(textarea);
      } else {
        const input = document.createElement('input');
        input.className = 'form-control';
        input.type = field.type === 'url' ? 'url' : 'text';
        input.name = field.id;
        input.placeholder = field.placeholder || '';
        if (field.required) input.required = true;
        wrapper.appendChild(input);
      }
      formFields.appendChild(wrapper);
    });

    if (template.extraNote) {
      extra.style.display = 'block';
      extra.innerHTML = template.extraNote;
    } else {
      extra.style.display = 'none';
    }

    if (submitBtn) {
      submitBtn.style.display = 'inline-flex';
    }
  }

